# API root; auth endpoints are resolved as /auth/* below this path.
# Configure this per deployment; the local .env is intentionally gitignored.
API_BASE_URL=https://api.example.com/api/v1
ENABLE_FCM=false

# Realtime (Laravel Reverb over Pusher protocol) — Flutter-only config.
# Host defaults to the API_BASE_URL host when empty. Android emulator
# should use 10.0.2.2. Production uses wss via REVERB_USE_TLS=true.
# Ports default to 8086 on loopback hosts, 80/443 on remote hosts
# (ngrok / proxied Reverb). Override only for custom Reverb ports.
REALTIME_ENABLED=true
REVERB_APP_KEY=bigbrainz_widget_key
REVERB_CLUSTER=mt1
REVERB_HOST=
REVERB_WS_PORT=
REVERB_WSS_PORT=
REVERB_USE_TLS=false
# Optional private-channel auth endpoint (future). Leave empty for public rooms.
REVERB_AUTH_ENDPOINT=
